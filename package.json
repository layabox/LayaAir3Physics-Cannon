{
  "name": "laya3.0physicscannon",
  "version": "1.0.0",
  "description": "cannon physics plugin for layaair3.0",
  "main": "CannonPhysics/dist/laya.cannon.js",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.js",
    "package": "npm run build && layaair export-installable-package CannonPhysics/dist --output out/com.layabox.cannon-js.layapkg",
    "preview": "npm run build && layaair run",
    "build:web": "npm run build && layaair build web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layabox/Laya3.0PhysicsCannon.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/layabox/Laya3.0PhysicsCannon/issues"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  },
  "homepage": "https://github.com/layabox/Laya3.0PhysicsCannon#readme"
}
